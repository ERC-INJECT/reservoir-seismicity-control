import ReservoirSeismicityControl.PaperA5CanonicalWeakRange
import ReservoirSeismicityControl.PaperA5PhysicalMovingNearBridge
import ReservoirSeismicityControl.PressurePositiveSemigroupA5PhysicalNeumann
import Mathlib.Tactic

/-!
# Stage 77 — construct the physical pressure path in the canonical weak Neumann domain

For the semigroup generated by an injective, dense, coercive symmetric form,
Stage 73 gives domain membership and continuity of the actual full multiwell
pressure generator. Stage 76 identifies that generator domain with the
canonical represented weak Neumann domain.

This file constructs the weak-domain pressure trajectory itself and proves
its carrier is exactly the physical mild solution, so Stage 74's `hpPhysical`
is no longer a premise. It also proves the weak Neumann image is continuous,
using the exact operator identity from Stage 76, so Stage 74's
`hOperatorIdent` is no longer a premise either.

The required semigroup self-adjointness and generator graph properties are
derived from the coercive form by the older physical A5 theorem; neither is
taken as an additional hypothesis here. No derivative of the well flux is
assumed. This result does not prove differentiability of the pressure path
or regularity of the moving seismicity observation weight.
-/

namespace ReservoirSeismicityControl

open MeasureTheory
open scoped NNReal InnerProductSpace

section CanonicalPhysicalWeakPath

variable {U H : Type*}
variable [NormedAddCommGroup U] [InnerProductSpace ℝ U] [CompleteSpace U]
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- From the *physical* mild pressure solution and canonical weak Neumann
realization, construct a weak-domain-valued path whose ambient L² carrier
is the exact physical state, and whose weak Neumann image is continuous.

No independent generator-graph/self-adjointness assumption, physical path
identification, or weak-generator equality is needed. -/
theorem pressure_A5_canonical_physical_weak_path_exists
    (j : U →L[ℝ] H)
    (B₁ Eform : U →L[ℝ] U →L[ℝ] ℝ)
    (hB₁ : IsCoercive B₁)
    (hForm₁ : ∀ x y : U, B₁ x y = ⟪j x, j y⟫_ℝ + Eform x y)
    (hE : ∀ x : U, 0 ≤ Eform x x)
    (hSym₁ : ∀ x y : U, B₁ x y = B₁ y x)
    (hjinj : Function.Injective j) (hjDense : DenseRange j) :
    let S := pressureNeumannGeneratedSemigroupOfDenseEmbedding
      j B₁ Eform hB₁ hForm₁ hE hSym₁ hjinj hjDense
    ∀ (T : NNReal) (p₀ : S.generatorDomain)
      (m : ℕ) (f : Fin m → H) (q : Fin m → ℝ → ℝ)
      (hq : ∀ i : Fin m, Integrable (q i)
        (volume.restrict (Set.Ico 0 (T : ℝ))))
      (M : Fin m → ℝ) (hM : ∀ i, 0 ≤ M i)
      (hBound : ∀ t : NNReal, t ≤ T → ∀ i : Fin m,
        ∀ᵐ s ∂(volume.restrict (Set.Ico 0 (t : ℝ))), |q i s| ≤ M i),
      ∃ p : ℝ → pressureWeakNeumannDomain
          (LinearMap.range j.toLinearMap)
          (pressureA5CanonicalRangeEnergy j Eform hjinj),
        (∀ τ : ℝ,
          (((p τ : LinearMap.range j.toLinearMap) : H)) =
            S (pressureA5HorizonClip T τ) (p₀ : H) +
              pressureA5ForwardDuhamel S (pressureA5HorizonClip T τ) m f q) ∧
        Continuous (fun τ : ℝ =>
          pressureWeakNeumannOperator
            (LinearMap.range j.toLinearMap)
            (pressureA5CanonicalRangeEnergy j Eform hjinj)
            (pressure_A5_canonical_range_separates j hjinj hjDense)
            (p τ)) := by
  intro S T p₀ m f q hq M hM hBound
  classical
  let V : Submodule ℝ H := LinearMap.range j.toLinearMap
  let Eweak : V →ₗ[ℝ] V →ₗ[ℝ] ℝ :=
    pressureA5CanonicalRangeEnergy j Eform hjinj
  let hsep : ∀ g : H, (∀ v : V, ⟪g, (v : H)⟫_ℝ = 0) → g = 0 :=
    pressure_A5_canonical_range_separates j hjinj hjDense
  obtain ⟨hSelf, hGraph⟩ :=
    pressure_dense_neumann_semigroup_selfadjoint_and_graph
      j B₁ Eform hB₁ hForm₁ hE hSym₁ hjinj hjDense
  obtain ⟨F, hFCont, hF⟩ :=
    pressure_A5_general_multiwell_generator_continuous_representative
      S hSelf hGraph T p₀ m f q hq M hM hBound
  let physical : ℝ → H := fun τ =>
    S (pressureA5HorizonClip T τ) (p₀ : H) +
      pressureA5ForwardDuhamel S (pressureA5HorizonClip T τ) m f q
  have hDom (τ : ℝ) : physical τ ∈ S.generatorDomain := by
    let t : NNReal := pressureA5HorizonClip T τ
    have ht : t ≤ T := min_le_right _ _
    exact (hF t ht).choose
  have hRepresentative (τ : ℝ) :
      ∃ x : pressureWeakNeumannDomain V Eweak,
        (((x : V) : H)) = physical τ := by
    exact (pressure_A5_canonical_range_domain_iff_generator_domain
      j B₁ Eform hB₁ hForm₁ hE hSym₁ hjinj hjDense
      (physical τ)).mpr (hDom τ)
  let p : ℝ → pressureWeakNeumannDomain V Eweak :=
    fun τ => Classical.choose (hRepresentative τ)
  have hpPhysical (τ : ℝ) :
      (((p τ : V) : H)) = physical τ :=
    Classical.choose_spec (hRepresentative τ)
  refine ⟨p, ?_, ?_⟩
  · exact hpPhysical
  · exact pressure_A5_weak_near_graph_continuous_of_physical
      S hSelf hGraph T p₀ m f q hq M hM hBound
      V Eweak hsep p hpPhysical
      (by
        intro u hu
        exact pressure_A5_canonical_range_operator_eq_neg_generator
          j B₁ Eform hB₁ hForm₁ hE hSym₁ hjinj hjDense u hu)

end CanonicalPhysicalWeakPath
end ReservoirSeismicityControl

#print axioms ReservoirSeismicityControl.pressure_A5_canonical_physical_weak_path_exists
